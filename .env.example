# OMP demo database access.
# Recommended: copy to ~/.config/omp-yield/env and fill in the read-only
# account created in Phase 0. A project-local .env is also supported, but the
# project may be Syncthing-synced, so keep secrets outside the synced tree.
# The CLI also falls back to docker-build/.env for local development.
OMP_DB_HOST=localhost
OMP_DB_PORT=1433
OMP_DB_USER=omp_ds_readonly
OMP_DB_PASSWORD=change-me
OMP_DB_DATABASE=omp_as_demo
OMP_DB_ENCRYPT=true
OMP_DB_TRUST_SERVER_CERTIFICATE=true
OMP_DB_QUERY_TIMEOUT_SECONDS=30
OMP_QUERY_ROW_LIMIT=1000

# Optional: point at a specific env file instead of .env
# OMP_ENV_FILE=/path/to/.env
